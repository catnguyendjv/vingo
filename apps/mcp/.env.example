# study-kit-mcp env. Dev localhost: mọi giá trị dưới đây đã có default trong config.ts
# (Supabase local well-known) nên có thể chạy mà KHÔNG cần file .env. Copy sang .env để override.

# Server
PORT=8787
BASE_URL=http://localhost:8787
WEB_URL=http://localhost:3000

# Supabase — local lấy anon/service/jwt từ: supabase status -o env
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...      # ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... # SERVICE_ROLE_KEY
# Ký user-JWT (HS256). Local = JWT_SECRET của supabase status.
# Cloud: dùng legacy JWT secret của project. Rotate secret ⇒ cập nhật biến này (runbook §9).
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ffmpeg/ffprobe: bỏ trống ở dev (dùng ffmpeg-static/ffprobe-static qua npm).
# Trong Docker (ffmpeg apt) trỏ tới binary hệ thống:
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Ingest
INGEST_MAX_BYTES=5368709120     # 5 GiB
INGEST_TIMEOUT_MS=1800000       # 30'
JANITOR_STALE_MIN=30
